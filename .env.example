# Copia este archivo como .env.local y completa los valores.
# Supabase Dashboard -> Project Settings -> API (o botón "Connect").

# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (sb_publishable_...). También sirve la clave "anon" (legacy).
# Es segura en el navegador siempre que las tablas tengan RLS activado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de esta app (para el enlace de confirmación de correo).
# En producción, cámbiala por tu dominio. Debe estar en Supabase ->
# Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA pongas aquí la clave secreta/service_role con prefijo NEXT_PUBLIC_.
